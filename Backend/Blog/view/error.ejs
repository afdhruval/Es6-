<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %> | InkFlow</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden bg-[var(--color-bg-main)]">

  <div class="bg-blob-1"></div>
  <div class="bg-blob-2"></div>

  <div class="w-full max-w-lg px-6 py-10 relative z-10 text-center">
    <div class="glass-card p-12 shadow-[0_0_40px_rgba(0,0,0,0.5)]">
      
      <i class="fa-solid fa-triangle-exclamation text-7xl text-red-500 mb-6 drop-shadow-[0_0_15px_rgba(239,68,68,0.5)]"></i>
      
      <h1 class="text-3xl font-bold font-serif tracking-tight mb-4"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></h1>
      
      <p class="text-gray-400 mb-8">
        We couldn't find what you're looking for, or an unexpected error occurred on our end.
      </p>

      <a href="/" class="btn-primary">
        <i class="fa-solid fa-arrow-left mr-2"></i> Return Home
      </a>

    </div>
  </div>

</body>
</html>
