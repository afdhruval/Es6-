<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %> | BLOGGY</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    body { font-family: 'Jost', sans-serif; }
    .btn-solid { background-color: black; color: white; transition: background-color 0.3s ease; }
    .btn-solid:hover { background-color: #333; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-white text-black p-6">

  <div class="w-full max-w-lg border border-gray-200 p-16 text-center shadow-sm">
      
    <h1 class="text-8xl font-black tracking-tighter mb-6">404</h1>
      
    <h2 class="text-xl font-bold uppercase tracking-widest mb-4"><%= typeof message !== 'undefined' ? message : 'PAGE NOT FOUND' %></h2>
    
    <p class="text-gray-500 mb-10 text-sm">
      The page you're looking for doesn't exist or an error occurred.
    </p>

    <a href="/" class="btn-solid inline-block px-10 py-4 font-bold uppercase tracking-widest text-sm">
      Return Home
    </a>

  </div>

</body>
</html>
