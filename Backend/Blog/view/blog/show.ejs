<%- include('../partials/header') %>

<article class="max-w-4xl mx-auto px-6 py-16">
  
  <a href="/" class="inline-block text-xs font-bold uppercase tracking-widest border-b border-black pb-1 mb-12 hover:text-gray-500 hover:border-gray-500 transition-colors">
    <i class="fa-solid fa-arrow-left mr-2"></i> Back to Home
  </a>

  <!-- Header -->
  <header class="mb-12">
    <div class="inline-block px-3 py-1 border border-black text-xs font-bold uppercase tracking-widest mb-6">
      <%= blog.category %>
    </div>
    
    <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-tight mb-8">
      <%= blog.title %>
    </h1>
    
    <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-widest text-gray-500 border-t border-b border-gray-200 py-4">
      <span><%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
      <span class="w-1 h-1 bg-black"></span>
      <span>5 MIN READ</span>
    </div>
  </header>

  <!-- Cover Image -->
  <div class="w-full aspect-[21/9] bg-gray-100 mb-16">
    <img src="<%= blog.images || 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=1000' %>" 
         alt="<%= blog.title %>" class="w-full h-full object-cover" />
  </div>

  <!-- Content -->
  <div class="max-w-3xl mx-auto">
    <div class="prose prose-lg max-w-none prose-p:leading-loose prose-a:text-black hover:prose-a:underline prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight">
      <p class="whitespace-pre-wrap text-lg leading-relaxed text-gray-800"><%= blog.content %></p>
    </div>
  </div>

</article>

<%- include('../partials/footer') %>
