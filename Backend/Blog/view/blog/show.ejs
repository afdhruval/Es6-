<%- include('../partials/header') %>

<article class="max-w-4xl mx-auto px-6 py-16">
  
  <a href="/" class="inline-flex items-center gap-2 text-gray-400 hover:text-accent font-medium mb-10 transition-colors">
    <i class="fa-solid fa-arrow-left"></i> Back to Explore
  </a>

  <!-- Header -->
  <header class="mb-14 text-center">
    <div class="inline-block px-4 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-bold uppercase tracking-widest mb-6">
      <%= blog.category %>
    </div>
    
    <h1 class="font-serif text-4xl md:text-6xl font-bold tracking-tight leading-tight mb-8">
      <%= blog.title %>
    </h1>
    
    <div class="flex items-center justify-center gap-4 text-sm text-gray-400">
      <div class="flex items-center gap-2">
        <i class="fa-regular fa-calendar"></i>
        <span><%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
      </div>
      <span class="w-1 h-1 rounded-full bg-gray-600"></span>
      <div class="flex items-center gap-2">
        <i class="fa-regular fa-clock"></i>
        <span>5 min read</span>
      </div>
    </div>
  </header>

  <!-- Cover Image -->
  <div class="w-full h-[300px] md:h-[500px] rounded-3xl overflow-hidden mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative">
    <div class="absolute inset-0 bg-primary/20 mix-blend-overlay z-10 pointer-events-none"></div>
    <img src="<%= blog.images || 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=1000' %>" 
         alt="<%= blog.title %>" class="w-full h-full object-cover" />
  </div>

  <!-- Content -->
  <div class="prose prose-invert prose-lg max-w-none prose-p:leading-loose prose-a:text-accent hover:prose-a:text-primary-light prose-headings:font-serif">
    <p class="whitespace-pre-wrap text-gray-300 text-lg leading-relaxed"><%= blog.content %></p>
  </div>

  <!-- Footer Actions -->
  <div class="mt-20 pt-10 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-4">
      <button class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-red-400 hover:bg-red-400/10 hover:border-red-400/30 transition-all duration-300">
        <i class="fa-regular fa-heart text-xl"></i>
      </button>
      <button class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-accent hover:bg-accent/10 hover:border-accent/30 transition-all duration-300">
        <i class="fa-regular fa-bookmark text-xl"></i>
      </button>
    </div>

    <div class="flex items-center gap-3 text-gray-400 font-medium">
      <span>Share:</span>
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors"><i class="fa-brands fa-twitter"></i></a>
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors"><i class="fa-brands fa-facebook-f"></i></a>
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors"><i class="fa-solid fa-link"></i></a>
    </div>
  </div>

</article>

<%- include('../partials/footer') %>
