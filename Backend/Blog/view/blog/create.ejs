<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto px-6 py-20">
  <div class="glass-card p-10 md:p-14 border-t-4 border-t-primary relative overflow-hidden">
    <!-- Decor element -->
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/20 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="mb-10 relative z-10">
      <h1 class="text-3xl font-bold font-serif mb-2 tracking-tight">Draft a New Masterpiece</h1>
      <p class="text-gray-400">Share your thoughts, experiences, and expertise with the world.</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-xl mb-8 flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/blog" method="POST" class="space-y-8 relative z-10">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-3">
          <label class="block text-sm font-semibold text-gray-300 uppercase tracking-wider">Title</label>
          <input type="text" name="title" required placeholder="Enter a captivating title" class="input-field" />
        </div>
        
        <div class="space-y-3">
          <label class="block text-sm font-semibold text-gray-300 uppercase tracking-wider">Category</label>
          <input type="text" name="category" required placeholder="e.g. Technology, Lifestyle" class="input-field" />
        </div>
      </div>

      <div class="space-y-3">
        <label class="block text-sm font-semibold text-gray-300 uppercase tracking-wider">Cover Image URL (Optional)</label>
        <input type="url" name="images" placeholder="https://example.com/image.jpg" class="input-field" />
        <p class="text-xs text-gray-500 mt-1">Leave blank to use a default aesthetic cover.</p>
      </div>

      <div class="space-y-3">
        <label class="block text-sm font-semibold text-gray-300 uppercase tracking-wider">Content</label>
        <textarea name="content" required placeholder="Tell your story..." class="input-field min-h-[300px] resize-y leading-relaxed"></textarea>
      </div>

      <div class="pt-6 flex items-center justify-end gap-4 border-t border-white/10">
        <a href="/" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">
          Publish Story <i class="fa-solid fa-paper-plane ml-1"></i>
        </button>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
