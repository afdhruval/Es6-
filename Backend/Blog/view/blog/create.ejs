<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto px-6 py-20">
  
  <div class="mb-12 border-b border-black pb-6">
    <h1 class="text-4xl font-black uppercase tracking-tight mb-2">Write a Post</h1>
    <p class="text-gray-500">Publish your story to the world.</p>
  </div>

  <% if (error) { %>
    <div class="bg-black text-white px-4 py-3 mb-8 text-sm font-medium uppercase tracking-wider text-center">
      <%= error %>
    </div>
  <% } %>

  <form action="/blog" method="POST" class="space-y-8">
    
    <div>
      <label class="block text-xs font-bold uppercase tracking-widest mb-2">Title</label>
      <input type="text" name="title" required class="input-clean w-full px-4 py-3 text-lg font-bold" />
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <label class="block text-xs font-bold uppercase tracking-widest mb-2">Category</label>
        <input type="text" name="category" required class="input-clean w-full px-4 py-3" />
      </div>
      
      <div>
        <label class="block text-xs font-bold uppercase tracking-widest mb-2">Cover Image URL</label>
        <input type="url" name="images" class="input-clean w-full px-4 py-3" />
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold uppercase tracking-widest mb-2">Content</label>
      <textarea name="content" required class="input-clean w-full px-4 py-4 min-h-[400px] resize-y leading-relaxed text-lg"></textarea>
    </div>

    <div class="pt-6 flex gap-4">
      <button type="submit" class="btn-solid flex-1 py-4 font-bold uppercase tracking-widest text-sm">
        Publish
      </button>
      <a href="/" class="btn-outline px-8 py-4 font-bold uppercase tracking-widest text-sm text-center">
        Cancel
      </a>
    </div>

  </form>
</div>

<%- include('../partials/footer') %>
