<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | BLOGGY</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    body { font-family: 'Jost', sans-serif; }
    .btn-solid { background-color: black; color: white; transition: background-color 0.3s ease; }
    .btn-solid:hover { background-color: #333; }
    .input-clean { border: 1px solid #e5e7eb; background: #fafafa; transition: border-color 0.3s ease; }
    .input-clean:focus { outline: none; border-color: black; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-white text-black p-6">

  <div class="w-full max-w-md border border-gray-200 p-10 shadow-sm">
      
    <div class="text-center mb-10">
      <h1 class="text-3xl font-black uppercase tracking-widest mb-2">REGISTER</h1>
      <p class="text-gray-500 text-sm">CREATE YOUR ACCOUNT</p>
    </div>

    <% if (error) { %>
      <div class="bg-black text-white px-4 py-3 mb-6 text-xs font-bold uppercase tracking-wider text-center">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" class="space-y-6">
      
      <div>
        <label class="block text-xs font-bold uppercase tracking-widest mb-2">Username</label>
        <input type="text" name="username" required class="input-clean w-full px-4 py-3" />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-widest mb-2">Email</label>
        <input type="email" name="email" required class="input-clean w-full px-4 py-3" />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-widest mb-2">Password</label>
        <input type="password" name="password" required minlength="6" class="input-clean w-full px-4 py-3" />
      </div>

      <button type="submit" class="btn-solid w-full py-4 font-bold uppercase tracking-widest text-sm mt-4">
        Create Account
      </button>
    </form>

    <div class="mt-8 text-center border-t border-gray-200 pt-6">
      <p class="text-sm text-gray-500 uppercase tracking-wider">
        Have an account? <a href="/auth/login" class="text-black font-bold hover:underline ml-1">Login</a>
      </p>
    </div>
    
    <div class="mt-6 text-center">
      <a href="/" class="text-xs font-bold uppercase tracking-widest border-b border-black pb-1 hover:text-gray-500 hover:border-gray-500">Back to Home</a>
    </div>

  </div>

</body>
</html>
