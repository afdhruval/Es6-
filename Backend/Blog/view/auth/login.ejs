<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | InkFlow</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden bg-[var(--color-bg-main)]">

  <div class="bg-blob-1"></div>
  <div class="bg-blob-2"></div>

  <div class="w-full max-w-md px-6 py-10 relative z-10">
    <div class="glass-card p-10 flex flex-col shadow-[0_0_40px_rgba(0,0,0,0.5)]">
      
      <div class="flex flex-col items-center mb-10">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-primary to-indigo-500 shadow-[0_0_20px_rgba(124,58,237,0.5)] flex items-center justify-center text-white text-2xl mb-4">
          <i class="fa-solid fa-pen-nib"></i>
        </div>
        <h1 class="text-2xl font-bold font-serif tracking-tight">Welcome Back</h1>
        <p class="text-gray-400 text-sm mt-1">Sign in to continue your journey.</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-xl mb-6 text-sm text-center">
          <%= error %>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-4 py-3 rounded-xl mb-6 text-sm text-center">
          <%= success %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" class="space-y-6">
        <div class="space-y-2">
          <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Email Address</label>
          <div class="relative">
            <i class="fa-regular fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
            <input type="email" name="email" required placeholder="you@example.com" class="input-field pl-11" />
          </div>
        </div>

        <div class="space-y-2">
          <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
            <input type="password" name="password" required placeholder="••••••••" class="input-field pl-11" />
          </div>
        </div>

        <button type="submit" class="btn-primary w-full !py-3.5 mt-4">
          Sign In
        </button>
      </form>

      <div class="mt-8 text-center text-sm text-gray-400">
        New to InkFlow? 
        <a href="/auth/register" class="text-accent font-semibold hover:text-primary-light transition-colors ml-1">Create an account</a>
      </div>
      
      <div class="mt-8 text-center">
        <a href="/" class="text-xs text-gray-500 hover:text-gray-300 transition-colors"><i class="fa-solid fa-arrow-left mr-1"></i> Back to Home</a>
      </div>
      
    </div>
  </div>

</body>
</html>
