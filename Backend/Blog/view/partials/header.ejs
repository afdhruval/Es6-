<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | BLOGGY' : 'BLOGGY' %></title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Tailwind CSS Output -->
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    body { font-family: 'Jost', sans-serif; }
    .nav-link { position: relative; }
    .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 1px;
      bottom: -2px;
      left: 0;
      background-color: black;
      transition: width 0.3s ease;
    }
    .nav-link:hover::after { width: 100%; }
    
    .btn-solid {
      background-color: black;
      color: white;
      transition: background-color 0.3s ease;
    }
    .btn-solid:hover { background-color: #333; }
    
    .btn-outline {
      border: 1px solid black;
      color: black;
      background-color: transparent;
      transition: all 0.3s ease;
    }
    .btn-outline:hover {
      background-color: black;
      color: white;
    }
    
    .input-clean {
      border: 1px solid #e5e7eb;
      background: #fafafa;
      transition: border-color 0.3s ease;
    }
    .input-clean:focus {
      outline: none;
      border-color: black;
    }
  </style>
</head>
<body class="bg-white text-black">

  <!-- Navbar -->
  <nav class="sticky top-0 z-50 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      
      <!-- Desktop Nav Left -->
      <div class="hidden md:flex items-center gap-6 text-sm font-semibold uppercase tracking-wider">
        <a href="/" class="nav-link">Home</a>
      </div>

      <!-- Logo -->
      <a href="/" class="flex-1 flex justify-center md:flex-none">
        <span class="text-3xl font-black tracking-widest uppercase">BLOGGY</span>
      </a>

      <!-- Desktop Nav Right -->
      <div class="hidden md:flex items-center gap-6 text-sm font-semibold uppercase tracking-wider">
        <% if (user) { %>
          <a href="/blog/new" class="nav-link">Write</a>
          <div class="flex items-center gap-2 border-l border-gray-300 pl-6">
            <span><%= user.username %></span>
          </div>
          <a href="/auth/logout" class="nav-link text-gray-500">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="nav-link">Login</a>
        <% } %>
      </div>

    </div>
  </nav>

  <main class="min-h-[calc(100vh-200px)]">
