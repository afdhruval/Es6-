<!-- Top Navbar -->
<header class="sticky top-0 z-10 bg-slate-800/80 backdrop-blur-md border-b border-slate-700/50 px-6 py-4 flex items-center gap-4">
  <!-- Hamburger (mobile) -->
  <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white transition-colors">
    <i class="fa-solid fa-bars text-lg"></i>
  </button>

  <!-- Page Title -->
  <div class="flex items-center gap-2">
    <h1 class="text-base font-semibold text-white"><%= title %></h1>
  </div>

  <!-- Right side -->
  <div class="ml-auto flex items-center gap-4">
    <!-- Search Trigger -->
    <div class="hidden md:flex items-center gap-2 bg-slate-700/50 border border-slate-600/50 rounded-xl px-3 py-2 text-sm text-slate-400">
      <i class="fa-solid fa-magnifying-glass text-xs"></i>
      <span>Quick search...</span>
    </div>

    <!-- Notifications -->
    <div class="relative">
      <button class="w-9 h-9 rounded-xl bg-slate-700/50 border border-slate-600/50 flex items-center justify-center text-slate-400 hover:text-white hover:border-primary-500 transition-all duration-200">
        <i class="fa-solid fa-bell text-sm"></i>
      </button>
      <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-red-500 text-[10px] font-bold text-white flex items-center justify-center">3</span>
    </div>

    <!-- Admin Dropdown -->
    <div class="relative" id="admin-dropdown">
      <button onclick="toggleDropdown()" class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-slate-700/50 border border-slate-600/50 hover:border-primary-500/50 transition-all duration-200">
        <% if (currentUser && currentUser.avatar) { %>
          <img src="<%= currentUser.avatar %>" alt="Avatar" class="w-7 h-7 rounded-full object-cover" />
        <% } else { %>
          <div class="w-7 h-7 rounded-full bg-primary-600 flex items-center justify-center text-xs font-bold text-white">
            <%= currentUser ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
          </div>
        <% } %>
        <span class="text-sm font-medium text-slate-200 hidden md:block"><%= currentUser ? currentUser.name : 'Admin' %></span>
        <i class="fa-solid fa-chevron-down text-xs text-slate-400 hidden md:block transition-transform duration-200" id="chevron-icon"></i>
      </button>

      <!-- Dropdown Menu -->
      <div id="dropdown-menu" class="hidden absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-xl shadow-2xl overflow-hidden z-50">
        <div class="px-4 py-3 border-b border-slate-700">
          <p class="text-sm font-semibold text-white"><%= currentUser ? currentUser.name : 'Admin' %></p>
          <p class="text-xs text-slate-400"><%= currentUser ? currentUser.email : '' %></p>
        </div>
        <a href="/profile" class="flex items-center gap-3 px-4 py-3 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
          <i class="fa-solid fa-user-gear w-4 text-center"></i> My Profile
        </a>
        <div class="border-t border-slate-700"></div>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors">
          <i class="fa-solid fa-right-from-bracket w-4 text-center"></i> Logout
        </a>
      </div>
    </div>
  </div>
</header>

<script>
function toggleDropdown() {
  const menu = document.getElementById('dropdown-menu');
  const chevron = document.getElementById('chevron-icon');
  menu.classList.toggle('hidden');
  chevron && chevron.classList.toggle('rotate-180');
}
document.addEventListener('click', (e) => {
  const dropdown = document.getElementById('admin-dropdown');
  if (dropdown && !dropdown.contains(e.target)) {
    document.getElementById('dropdown-menu')?.classList.add('hidden');
    document.getElementById('chevron-icon')?.classList.remove('rotate-180');
  }
});
</script>
