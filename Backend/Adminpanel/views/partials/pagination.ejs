<% if (totalPages > 1) { %>
<div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-700/50">
  <p class="text-sm text-slate-400">
    Page <span class="font-semibold text-white"><%= currentPage %></span> of <span class="font-semibold text-white"><%= totalPages %></span>
    &nbsp;·&nbsp; <span class="font-semibold text-white"><%= total %></span> total records
  </p>
  <div class="flex items-center gap-1">
    <!-- Previous -->
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= typeof statusFilter !== 'undefined' && statusFilter ? '&status=' + statusFilter : '' %>"
         class="px-3 py-1.5 text-sm rounded-lg bg-slate-700 text-slate-300 hover:bg-primary-600 hover:text-white transition-colors">
        <i class="fa-solid fa-chevron-left text-xs"></i>
      </a>
    <% } else { %>
      <span class="px-3 py-1.5 text-sm rounded-lg bg-slate-800 text-slate-600 cursor-not-allowed">
        <i class="fa-solid fa-chevron-left text-xs"></i>
      </span>
    <% } %>

    <!-- Page Numbers -->
    <% 
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, currentPage + 2);
    %>
    <% for (let p = startPage; p <= endPage; p++) { %>
      <a href="?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= typeof statusFilter !== 'undefined' && statusFilter ? '&status=' + statusFilter : '' %>"
         class="px-3 py-1.5 text-sm rounded-lg transition-colors
         <%= p === currentPage ? 'bg-primary-600 text-white font-semibold shadow-lg' : 'bg-slate-700 text-slate-300 hover:bg-slate-600' %>">
        <%= p %>
      </a>
    <% } %>

    <!-- Next -->
    <% if (currentPage < totalPages) { %>
      <a href="?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= typeof statusFilter !== 'undefined' && statusFilter ? '&status=' + statusFilter : '' %>"
         class="px-3 py-1.5 text-sm rounded-lg bg-slate-700 text-slate-300 hover:bg-primary-600 hover:text-white transition-colors">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </a>
    <% } else { %>
      <span class="px-3 py-1.5 text-sm rounded-lg bg-slate-800 text-slate-600 cursor-not-allowed">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </span>
    <% } %>
  </div>
</div>
<% } %>
