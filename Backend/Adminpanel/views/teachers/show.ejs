<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-slate-500 mb-6">
  <a href="/teachers" class="hover:text-white transition-colors">Teachers</a>
  <i class="fa-solid fa-chevron-right text-xs"></i>
  <span class="text-slate-300"><%= teacher.name %></span>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <!-- Profile Card -->
  <div class="xl:col-span-1 space-y-4">
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-6 text-center">
      <% if (teacher.avatar) { %>
        <img src="<%= teacher.avatar %>" alt="<%= teacher.name %>" class="w-20 h-20 rounded-full object-cover mx-auto ring-4 ring-slate-600 mb-4" />
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-600 to-indigo-700 flex items-center justify-center text-2xl font-bold text-white mx-auto mb-4">
          <%= teacher.name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <h2 class="text-lg font-bold text-white"><%= teacher.name %></h2>
      <p class="text-sm text-slate-400"><%= teacher.email %></p>
      <p class="text-sm text-primary-400 mt-0.5"><%= teacher.specialization || 'No specialization' %></p>

      <div class="flex items-center justify-center gap-2 mt-3">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full
          <%= teacher.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' %>">
          <span class="w-1.5 h-1.5 rounded-full <%= teacher.status === 'active' ? 'bg-emerald-400' : 'bg-red-400' %>"></span>
          <%= teacher.status.charAt(0).toUpperCase() + teacher.status.slice(1) %>
        </span>
        <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full
          <%= teacher.approvalStatus === 'approved' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' :
              teacher.approvalStatus === 'pending' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' :
              'bg-red-500/10 text-red-400 border border-red-500/20' %>">
          <%= teacher.approvalStatus.charAt(0).toUpperCase() + teacher.approvalStatus.slice(1) %>
        </span>
      </div>

      <!-- Stats -->
      <div class="mt-5 grid grid-cols-3 gap-3 pt-4 border-t border-slate-700/50">
        <div>
          <p class="text-xl font-bold text-white"><%= courses.length %></p>
          <p class="text-xs text-slate-500">Courses</p>
        </div>
        <div>
          <p class="text-xl font-bold text-white"><%= totalStudents %></p>
          <p class="text-xs text-slate-500">Students</p>
        </div>
        <div>
          <p class="text-xl font-bold text-white">₹<%= (teacher.earnings || 0).toLocaleString('en-IN') %></p>
          <p class="text-xs text-slate-500">Earnings</p>
        </div>
      </div>

      <% if (teacher.bio) { %>
        <p class="mt-4 text-sm text-slate-400 text-left bg-slate-700/30 rounded-xl p-3"><%= teacher.bio %></p>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
      <h3 class="text-sm font-semibold text-white mb-3">Quick Actions</h3>
      <div class="space-y-2">
        <a href="/teachers/<%= teacher._id %>/edit"
          class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-indigo-600/20 hover:text-indigo-400 text-slate-300 text-sm transition-colors">
          <i class="fa-solid fa-pen w-4"></i> Edit Profile
        </a>
        <% if (teacher.approvalStatus === 'pending') { %>
          <form method="POST" action="/teachers/<%= teacher._id %>">
            <input type="hidden" name="_action" value="approve" />
            <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-emerald-600/20 hover:text-emerald-400 text-slate-300 text-sm transition-colors text-left">
              <i class="fa-solid fa-check w-4"></i> Approve Teacher
            </button>
          </form>
          <form method="POST" action="/teachers/<%= teacher._id %>">
            <input type="hidden" name="_action" value="reject" />
            <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-red-600/20 hover:text-red-400 text-slate-300 text-sm transition-colors text-left">
              <i class="fa-solid fa-xmark w-4"></i> Reject Teacher
            </button>
          </form>
        <% } %>
        <form method="POST" action="/teachers/<%= teacher._id %>">
          <input type="hidden" name="_action" value="<%= teacher.status === 'active' ? 'suspend' : 'activate' %>" />
          <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-amber-600/20 hover:text-amber-400 text-slate-300 text-sm transition-colors text-left">
            <i class="fa-solid <%= teacher.status === 'active' ? 'fa-ban' : 'fa-circle-check' %> w-4"></i>
            <%= teacher.status === 'active' ? 'Suspend Teacher' : 'Activate Teacher' %>
          </button>
        </form>
        <button onclick="document.getElementById('reset-pw-modal').classList.remove('hidden')"
          class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-blue-600/20 hover:text-blue-400 text-slate-300 text-sm transition-colors text-left">
          <i class="fa-solid fa-key w-4"></i> Reset Password
        </button>
        <form method="POST" action="/teachers/<%= teacher._id %>" onsubmit="return confirmDelete(event, '<%= teacher.name %>')">
          <input type="hidden" name="_action" value="delete" />
          <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-red-600/20 hover:text-red-400 text-slate-300 text-sm transition-colors text-left">
            <i class="fa-solid fa-trash w-4"></i> Delete Teacher
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Courses & Assign -->
  <div class="xl:col-span-2 space-y-4">
    <!-- Assign Course -->
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
      <h3 class="font-semibold text-white mb-3">Assign Course</h3>
      <form method="POST" action="/teachers/<%= teacher._id %>" class="flex gap-3">
        <input type="hidden" name="_action" value="assign-course" />
        <select name="courseId" class="flex-1 bg-slate-700/50 border border-slate-600 text-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-primary-500 transition-colors">
          <option value="">Select a course to assign...</option>
          <% courses && courses.forEach(course => { %>
            <option value="<%= course._id %>">
              <%= course.title %> (<%= course.category ? course.category.name : 'No category' %>)
            </option>
          <% }); %>
        </select>
        <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
          <i class="fa-solid fa-plus mr-1"></i> Assign
        </button>
      </form>
    </div>

    <!-- Assigned Courses -->
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-700/50 flex items-center justify-between">
        <h3 class="font-semibold text-white">Assigned Courses</h3>
        <span class="text-xs text-slate-400 bg-slate-700 px-2.5 py-1 rounded-full"><%= courses.length %> courses</span>
      </div>
      <% if (courses && courses.length > 0) { %>
        <div class="divide-y divide-slate-700/30">
          <% courses.forEach(course => { %>
            <div class="px-6 py-4 flex items-center gap-4 hover:bg-slate-700/20 transition-colors">
              <% if (course.thumbnail) { %>
                <img src="<%= course.thumbnail %>" class="w-12 h-10 rounded-lg object-cover flex-shrink-0" />
              <% } else { %>
                <div class="w-12 h-10 rounded-lg bg-indigo-600/20 border border-indigo-500/20 flex items-center justify-center flex-shrink-0">
                  <i class="fa-solid fa-book text-indigo-400 text-sm"></i>
                </div>
              <% } %>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-200 truncate"><%= course.title %></p>
                <p class="text-xs text-slate-500"><%= course.category ? course.category.name : 'No category' %> · ₹<%= course.price %></p>
              </div>
              <span class="text-xs font-medium px-2.5 py-1 rounded-full
                <%= course.status === 'published' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-slate-600 text-slate-400' %>">
                <%= course.status %>
              </span>
              <a href="/courses/<%= course._id %>/edit" class="text-slate-500 hover:text-indigo-400 transition-colors text-sm">
                <i class="fa-solid fa-pen"></i>
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-12 text-slate-500">
          <i class="fa-solid fa-book text-3xl mb-3 opacity-30"></i>
          <p class="text-sm">No courses assigned yet</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div id="reset-pw-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-semibold text-white">Reset Password</h3>
      <button onclick="document.getElementById('reset-pw-modal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form method="POST" action="/teachers/<%= teacher._id %>">
      <input type="hidden" name="_action" value="reset-password" />
      <div class="mb-4">
        <label class="block text-sm font-medium text-slate-300 mb-1.5">New Password</label>
        <input type="password" name="newPassword" required minlength="6" placeholder="Min. 6 characters"
          class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 transition-colors" />
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors">Reset Password</button>
        <button type="button" onclick="document.getElementById('reset-pw-modal').classList.add('hidden')"
          class="flex-1 bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm py-2.5 rounded-xl transition-colors">Cancel</button>
      </div>
    </form>
  </div>
</div>
