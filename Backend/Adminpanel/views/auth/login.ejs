<div class="bg-slate-800 border border-slate-700/60 rounded-2xl p-8 shadow-2xl">
  <!-- Logo -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-600 shadow-lg shadow-primary-900/50 mb-4">
      <i class="fa-solid fa-graduation-cap text-white text-2xl"></i>
    </div>
    <h1 class="text-2xl font-bold text-white">Welcome Back</h1>
    <p class="text-slate-400 text-sm mt-1">Sign in to your admin account</p>
  </div>

  <form method="POST" action="/login" class="space-y-5">
    <!-- Email -->
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-1.5" for="email">Email Address</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <i class="fa-solid fa-envelope text-slate-500 text-sm"></i>
        </span>
        <input
          type="email" id="email" name="email" required
          placeholder="admin@lms.com"
          class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors"
        />
      </div>
    </div>

    <!-- Password -->
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-1.5" for="password">Password</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <i class="fa-solid fa-lock text-slate-500 text-sm"></i>
        </span>
        <input
          type="password" id="password" name="password" required
          placeholder="••••••••"
          class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl pl-9 pr-10 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors"
        />
        <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-500 hover:text-slate-300">
          <i class="fa-solid fa-eye text-sm" id="eye-icon"></i>
        </button>
      </div>
    </div>

    <!-- Remember + Forgot -->
    <div class="flex items-center justify-between text-sm">
      <label class="flex items-center gap-2 text-slate-400 cursor-pointer">
        <input type="checkbox" name="remember" class="rounded border-slate-600 bg-slate-700 text-primary-600 focus:ring-primary-500" />
        Remember me
      </label>
      <a href="/forgot-password" class="text-primary-400 hover:text-primary-300 transition-colors">Forgot password?</a>
    </div>

    <!-- Submit -->
    <button type="submit" id="login-btn"
      class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-2.5 rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-primary-900/40 active:scale-95 text-sm flex items-center justify-center gap-2">
      <i class="fa-solid fa-right-to-bracket"></i>
      Sign In
    </button>
  </form>
</div>

<script>
function togglePassword() {
  const input = document.getElementById('password');
  const icon = document.getElementById('eye-icon');
  if (input.type === 'password') {
    input.type = 'text';
    icon.className = 'fa-solid fa-eye-slash text-sm';
  } else {
    input.type = 'password';
    icon.className = 'fa-solid fa-eye text-sm';
  }
}
</script>
