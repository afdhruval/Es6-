<!-- Page Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Overview</h2>
    <p class="text-slate-400 text-sm mt-0.5">Welcome back, <span class="text-primary-400 font-medium"><%= currentUser ? currentUser.name : 'Admin' %></span></p>
  </div>
  <div class="text-right text-sm text-slate-400">
    <p class="font-medium text-slate-200"><%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
  </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
  <!-- Total Students -->
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5 hover:border-blue-500/40 transition-all duration-200 group">
    <div class="flex items-center justify-between mb-4">
      <div class="w-11 h-11 rounded-xl bg-blue-500/15 border border-blue-500/20 flex items-center justify-center group-hover:bg-blue-500/25 transition-colors">
        <i class="fa-solid fa-user-graduate text-blue-400"></i>
      </div>
      <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-2.5 py-1">
        +<%= stats.newRegistrations || 0 %> this month
      </span>
    </div>
    <p class="text-2xl font-bold text-white mb-0.5"><%= stats.totalStudents || 0 %></p>
    <p class="text-sm text-slate-400">Total Students</p>
    <div class="mt-3 h-1.5 bg-slate-700 rounded-full overflow-hidden">
      <div class="h-full bg-blue-500 rounded-full transition-all duration-1000" style="width: <%= stats.activeStudents && stats.totalStudents ? Math.round((stats.activeStudents / stats.totalStudents) * 100) : 0 %>%"></div>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= stats.activeStudents || 0 %> active</p>
  </div>

  <!-- Total Teachers -->
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5 hover:border-purple-500/40 transition-all duration-200 group">
    <div class="flex items-center justify-between mb-4">
      <div class="w-11 h-11 rounded-xl bg-purple-500/15 border border-purple-500/20 flex items-center justify-center group-hover:bg-purple-500/25 transition-colors">
        <i class="fa-solid fa-chalkboard-teacher text-purple-400"></i>
      </div>
      <% if (stats.pendingTeachers > 0) { %>
        <span class="text-xs font-medium text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-full px-2.5 py-1">
          <%= stats.pendingTeachers %> pending
        </span>
      <% } %>
    </div>
    <p class="text-2xl font-bold text-white mb-0.5"><%= stats.totalTeachers || 0 %></p>
    <p class="text-sm text-slate-400">Total Teachers</p>
    <a href="/teachers?approval=pending" class="mt-3 text-xs text-purple-400 hover:text-purple-300 transition-colors flex items-center gap-1">
      <i class="fa-solid fa-arrow-right text-xs"></i> View pending approvals
    </a>
  </div>

  <!-- Total Courses -->
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5 hover:border-indigo-500/40 transition-all duration-200 group">
    <div class="flex items-center justify-between mb-4">
      <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-500/20 flex items-center justify-center group-hover:bg-indigo-500/25 transition-colors">
        <i class="fa-solid fa-book-open text-indigo-400"></i>
      </div>
      <span class="text-xs font-medium text-slate-400 bg-slate-700 rounded-full px-2.5 py-1">
        <%= stats.activeCourses || 0 %> published
      </span>
    </div>
    <p class="text-2xl font-bold text-white mb-0.5"><%= stats.totalCourses || 0 %></p>
    <p class="text-sm text-slate-400">Total Courses</p>
    <div class="mt-3 h-1.5 bg-slate-700 rounded-full overflow-hidden">
      <div class="h-full bg-indigo-500 rounded-full transition-all duration-1000" style="width: <%= stats.activeCourses && stats.totalCourses ? Math.round((stats.activeCourses / stats.totalCourses) * 100) : 0 %>%"></div>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= stats.activeCourses && stats.totalCourses ? Math.round((stats.activeCourses / stats.totalCourses) * 100) : 0 %>% published</p>
  </div>

  <!-- Revenue -->
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5 hover:border-emerald-500/40 transition-all duration-200 group">
    <div class="flex items-center justify-between mb-4">
      <div class="w-11 h-11 rounded-xl bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center group-hover:bg-emerald-500/25 transition-colors">
        <i class="fa-solid fa-indian-rupee-sign text-emerald-400"></i>
      </div>
      <span class="text-xs font-medium text-slate-400 bg-slate-700 rounded-full px-2.5 py-1">
        <%= stats.totalEnrollments || 0 %> enrollments
      </span>
    </div>
    <p class="text-2xl font-bold text-white mb-0.5">₹<%= (stats.totalRevenue || 0).toLocaleString('en-IN') %></p>
    <p class="text-sm text-slate-400">Total Revenue</p>
    <a href="/courses" class="mt-3 text-xs text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-1">
      <i class="fa-solid fa-arrow-right text-xs"></i> View all courses
    </a>
  </div>
</div>

<!-- Second row stats -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-9 h-9 rounded-lg bg-cyan-500/15 flex items-center justify-center">
        <i class="fa-solid fa-tags text-cyan-400 text-sm"></i>
      </div>
      <p class="text-sm text-slate-400">Categories</p>
    </div>
    <p class="text-3xl font-bold text-white"><%= stats.totalCategories || 0 %></p>
  </div>
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-9 h-9 rounded-lg bg-green-500/15 flex items-center justify-center">
        <i class="fa-solid fa-signal text-green-400 text-sm"></i>
      </div>
      <p class="text-sm text-slate-400">Active Courses</p>
    </div>
    <p class="text-3xl font-bold text-white"><%= stats.activeCourses || 0 %></p>
  </div>
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-9 h-9 rounded-lg bg-pink-500/15 flex items-center justify-center">
        <i class="fa-solid fa-user-plus text-pink-400 text-sm"></i>
      </div>
      <p class="text-sm text-slate-400">New Registrations</p>
    </div>
    <p class="text-3xl font-bold text-white"><%= stats.newRegistrations || 0 %></p>
  </div>
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-9 h-9 rounded-lg bg-amber-500/15 flex items-center justify-center">
        <i class="fa-solid fa-trophy text-amber-400 text-sm"></i>
      </div>
      <p class="text-sm text-slate-400">Completion Rate</p>
    </div>
    <p class="text-3xl font-bold text-white"><%= stats.completionRate || 0 %>%</p>
    <div class="mt-2 h-1.5 bg-slate-700 rounded-full overflow-hidden">
      <div class="h-full bg-amber-500 rounded-full" style="width: <%= stats.completionRate || 0 %>%"></div>
    </div>
  </div>
</div>

<!-- Recent Enrollments + Activities -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <!-- Recent Enrollments Table -->
  <div class="xl:col-span-2 bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700/50">
      <h3 class="font-semibold text-white">Recent Enrollments</h3>
      <a href="/students" class="text-xs text-primary-400 hover:text-primary-300 transition-colors flex items-center gap-1">
        View all <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
    <div class="overflow-x-auto">
      <% if (recentEnrollments && recentEnrollments.length > 0) { %>
        <table class="w-full">
          <thead>
            <tr class="text-xs text-slate-500 uppercase tracking-wider border-b border-slate-700/50">
              <th class="px-6 py-3 text-left">Student</th>
              <th class="px-6 py-3 text-left">Course</th>
              <th class="px-6 py-3 text-left">Amount</th>
              <th class="px-6 py-3 text-left">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700/30">
            <% recentEnrollments.forEach(enrollment => { %>
              <tr class="hover:bg-slate-700/30 transition-colors">
                <td class="px-6 py-3">
                  <div class="flex items-center gap-3">
                    <% if (enrollment.student && enrollment.student.avatar) { %>
                      <img src="<%= enrollment.student.avatar %>" class="w-8 h-8 rounded-full object-cover" />
                    <% } else { %>
                      <div class="w-8 h-8 rounded-full bg-blue-600/30 border border-blue-500/30 flex items-center justify-center text-xs font-bold text-blue-400">
                        <%= enrollment.student ? enrollment.student.name.charAt(0).toUpperCase() : '?' %>
                      </div>
                    <% } %>
                    <span class="text-sm font-medium text-slate-200"><%= enrollment.student ? enrollment.student.name : 'N/A' %></span>
                  </div>
                </td>
                <td class="px-6 py-3 text-sm text-slate-400 max-w-[160px] truncate"><%= enrollment.course ? enrollment.course.title : 'N/A' %></td>
                <td class="px-6 py-3">
                  <span class="text-sm font-semibold text-emerald-400">₹<%= (enrollment.amountPaid || 0).toLocaleString('en-IN') %></span>
                </td>
                <td class="px-6 py-3 text-xs text-slate-500">
                  <%= enrollment.createdAt ? enrollment.createdAt.toLocaleDateString('en-IN') : 'N/A' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-12 text-slate-500">
          <i class="fa-solid fa-inbox text-4xl mb-3 opacity-30"></i>
          <p class="text-sm">No enrollments yet</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent Activities -->
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-700/50">
      <h3 class="font-semibold text-white">Recent Activities</h3>
    </div>
    <div class="px-4 py-4 space-y-1 max-h-80 overflow-y-auto">
      <% if (recentActivities && recentActivities.length > 0) { %>
        <% recentActivities.forEach(activity => { %>
          <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-slate-700/30 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-slate-700 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fa-solid <%= activity.icon || 'fa-bell' %> text-xs
                <%= activity.color === 'blue' ? 'text-blue-400' :
                    activity.color === 'purple' ? 'text-purple-400' :
                    activity.color === 'green' ? 'text-emerald-400' :
                    activity.color === 'red' ? 'text-red-400' :
                    activity.color === 'indigo' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-slate-300 leading-snug"><%= activity.message %></p>
              <p class="text-xs text-slate-500 mt-0.5"><%= activity.createdAt ? activity.createdAt.toLocaleDateString('en-IN') : '' %></p>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-8 text-slate-500">
          <i class="fa-solid fa-bell-slash text-3xl mb-2 opacity-30"></i>
          <p class="text-sm">No recent activities</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
