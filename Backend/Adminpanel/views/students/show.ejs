<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-slate-500 mb-6">
  <a href="/students" class="hover:text-white transition-colors">Students</a>
  <i class="fa-solid fa-chevron-right text-xs"></i>
  <span class="text-slate-300"><%= student.name %></span>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <!-- Profile Card -->
  <div class="xl:col-span-1 space-y-4">
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-6 text-center">
      <% if (student.avatar) { %>
        <img src="<%= student.avatar %>" alt="<%= student.name %>" class="w-20 h-20 rounded-full object-cover mx-auto ring-4 ring-slate-600 mb-4" />
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-2xl font-bold text-white mx-auto mb-4">
          <%= student.name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <h2 class="text-lg font-bold text-white"><%= student.name %></h2>
      <p class="text-sm text-slate-400"><%= student.email %></p>
      <p class="text-sm text-slate-500 mt-0.5"><%= student.phone || 'No phone' %></p>

      <div class="mt-4">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full
          <%= student.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' %>">
          <span class="w-1.5 h-1.5 rounded-full <%= student.status === 'active' ? 'bg-emerald-400' : 'bg-red-400' %>"></span>
          <%= student.status.charAt(0).toUpperCase() + student.status.slice(1) %>
        </span>
      </div>

      <% if (student.bio) { %>
        <p class="mt-4 text-sm text-slate-400 text-left bg-slate-700/30 rounded-xl p-3"><%= student.bio %></p>
      <% } %>

      <div class="mt-4 pt-4 border-t border-slate-700/50 text-xs text-slate-500">
        Joined <%= student.createdAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl p-5">
      <h3 class="text-sm font-semibold text-white mb-3">Quick Actions</h3>
      <div class="space-y-2">
        <a href="/students/<%= student._id %>/edit"
          class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-indigo-600/20 hover:text-indigo-400 text-slate-300 text-sm transition-colors">
          <i class="fa-solid fa-pen w-4"></i> Edit Profile
        </a>
        <form method="POST" action="/students/<%= student._id %>">
          <input type="hidden" name="_action" value="<%= student.status === 'active' ? 'suspend' : 'activate' %>" />
          <button type="submit"
            class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-amber-600/20 hover:text-amber-400 text-slate-300 text-sm transition-colors text-left">
            <i class="fa-solid <%= student.status === 'active' ? 'fa-ban' : 'fa-circle-check' %> w-4"></i>
            <%= student.status === 'active' ? 'Suspend Student' : 'Activate Student' %>
          </button>
        </form>

        <!-- Reset Password Modal Trigger -->
        <button onclick="document.getElementById('reset-pw-modal').classList.remove('hidden')"
          class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-blue-600/20 hover:text-blue-400 text-slate-300 text-sm transition-colors text-left">
          <i class="fa-solid fa-key w-4"></i> Reset Password
        </button>

        <form method="POST" action="/students/<%= student._id %>" onsubmit="return confirmDelete(event, '<%= student.name %>')">
          <input type="hidden" name="_action" value="delete" />
          <button type="submit"
            class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl bg-slate-700/50 hover:bg-red-600/20 hover:text-red-400 text-slate-300 text-sm transition-colors text-left">
            <i class="fa-solid fa-trash w-4"></i> Delete Student
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Enrolled Courses -->
  <div class="xl:col-span-2">
    <div class="bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-700/50 flex items-center justify-between">
        <h3 class="font-semibold text-white">Enrolled Courses</h3>
        <span class="text-xs text-slate-400 bg-slate-700 px-2.5 py-1 rounded-full"><%= enrollments.length %> courses</span>
      </div>

      <% if (enrollments && enrollments.length > 0) { %>
        <div class="divide-y divide-slate-700/30">
          <% enrollments.forEach(enrollment => { %>
            <div class="px-6 py-4 hover:bg-slate-700/20 transition-colors">
              <div class="flex items-center gap-4">
                <% if (enrollment.course && enrollment.course.thumbnail) { %>
                  <img src="<%= enrollment.course.thumbnail %>" class="w-12 h-10 rounded-lg object-cover flex-shrink-0" />
                <% } else { %>
                  <div class="w-12 h-10 rounded-lg bg-indigo-600/20 border border-indigo-500/20 flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-book text-indigo-400 text-sm"></i>
                  </div>
                <% } %>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-slate-200 truncate"><%= enrollment.course ? enrollment.course.title : 'N/A' %></p>
                  <p class="text-xs text-slate-500 mt-0.5">
                    Enrolled <%= enrollment.enrolledAt ? enrollment.enrolledAt.toLocaleDateString('en-IN') : 'N/A' %>
                    · ₹<%= (enrollment.amountPaid || 0).toLocaleString('en-IN') %>
                  </p>
                </div>
                <div class="text-right flex-shrink-0">
                  <!-- Progress Bar -->
                  <p class="text-xs font-semibold mb-1.5 <%= enrollment.progress >= 100 ? 'text-emerald-400' : 'text-slate-300' %>">
                    <%= enrollment.progress || 0 %>%
                  </p>
                  <div class="w-24 h-1.5 bg-slate-700 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500
                      <%= enrollment.progress >= 100 ? 'bg-emerald-500' : enrollment.progress >= 50 ? 'bg-primary-500' : 'bg-amber-500' %>"
                      style="width: <%= enrollment.progress || 0 %>%"></div>
                  </div>
                  <span class="text-xs text-slate-500 mt-1 block"><%= enrollment.status %></span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-12 text-slate-500">
          <i class="fa-solid fa-book text-3xl mb-3 opacity-30"></i>
          <p class="text-sm">No courses enrolled yet</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div id="reset-pw-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-semibold text-white">Reset Password</h3>
      <button onclick="document.getElementById('reset-pw-modal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form method="POST" action="/students/<%= student._id %>">
      <input type="hidden" name="_action" value="reset-password" />
      <div class="mb-4">
        <label class="block text-sm font-medium text-slate-300 mb-1.5">New Password</label>
        <input type="password" name="newPassword" required minlength="6" placeholder="Min. 6 characters"
          class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 transition-colors" />
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors">
          <i class="fa-solid fa-key mr-1"></i> Reset Password
        </button>
        <button type="button" onclick="document.getElementById('reset-pw-modal').classList.add('hidden')"
          class="flex-1 bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm py-2.5 rounded-xl transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>
