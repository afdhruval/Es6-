<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-slate-500 mb-6">
  <a href="/students" class="hover:text-white transition-colors">Students</a>
  <i class="fa-solid fa-chevron-right text-xs"></i>
  <span class="text-slate-300">Add New Student</span>
</div>

<div class="max-w-2xl">
  <div class="bg-slate-800 border border-slate-700/50 rounded-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-700/50">
      <h2 class="text-base font-semibold text-white">Student Information</h2>
      <p class="text-sm text-slate-400 mt-0.5">Fill in the details to create a new student account</p>
    </div>

    <form method="POST" action="/students/create" enctype="multipart/form-data" class="px-6 py-6 space-y-5">
      <!-- Avatar Upload -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Profile Photo <span class="text-slate-500">(optional)</span></label>
        <div class="flex items-center gap-4">
          <div id="avatar-preview" class="w-16 h-16 rounded-full bg-slate-700 border-2 border-dashed border-slate-600 flex items-center justify-center overflow-hidden">
            <i class="fa-solid fa-user text-slate-500 text-xl" id="avatar-placeholder"></i>
          </div>
          <div>
            <label class="cursor-pointer inline-flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm font-medium px-4 py-2 rounded-xl transition-colors border border-slate-600">
              <i class="fa-solid fa-upload text-xs"></i> Upload Photo
              <input type="file" name="avatar" accept="image/*" class="hidden" onchange="previewAvatar(this)" />
            </label>
            <p class="text-xs text-slate-500 mt-1">JPG, PNG, GIF up to 5MB</p>
          </div>
        </div>
      </div>

      <!-- Name & Email -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1.5">Full Name <span class="text-red-400">*</span></label>
          <input type="text" name="name" required placeholder="John Doe"
            class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1.5">Email Address <span class="text-red-400">*</span></label>
          <input type="email" name="email" required placeholder="john@example.com"
            class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors" />
        </div>
      </div>

      <!-- Password & Phone -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1.5">Password <span class="text-red-400">*</span></label>
          <input type="password" name="password" required minlength="6" placeholder="Min. 6 characters"
            class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1.5">Phone Number</label>
          <input type="tel" name="phone" placeholder="+91 99999 99999"
            class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors" />
        </div>
      </div>

      <!-- Bio -->
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1.5">Bio <span class="text-slate-500">(optional)</span></label>
        <textarea name="bio" rows="3" placeholder="Short bio about the student..."
          class="w-full bg-slate-700/50 border border-slate-600 text-white placeholder-slate-500 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500/50 transition-colors resize-none"></textarea>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3 pt-2">
        <button type="submit"
          class="bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-primary-900/30 flex items-center gap-2">
          <i class="fa-solid fa-user-plus"></i> Create Student
        </button>
        <a href="/students" class="bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<script>
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = (e) => {
      const preview = document.getElementById('avatar-preview');
      preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover" />`;
    };
    reader.readAsDataURL(input.files[0]);
  }
}
</script>
