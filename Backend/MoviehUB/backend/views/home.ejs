<!DOCTYPE html>
<html>
<head>
    <title>MovieMania</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900">

<nav class="bg-black text-white p-4 flex justify-between">
    <h1 class="text-3xl font-bold">
        MovieMania
    </h1>

    <a
      href="/api/movie/movies"
      class="bg-yellow-500 px-4 py-2 rounded text-black"
    >
      All Movies
    </a>
</nav>

<h1 class="text-center text-white text-5xl font-bold my-8">
    Latest Movies
</h1>

<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 p-6">

<% movies.forEach(movie => { %>

<div class="bg-white rounded-lg overflow-hidden shadow-lg">

    <img
      src="<%= movie.imgUrl %>"
      alt="<%= movie.title %>"
      class="h-80 w-full object-cover"
    >

    <div class="p-4">

        <h2 class="text-2xl font-bold">
            <%= movie.title %>
        </h2>

        <p class="text-gray-600">
            <%= movie.hero %>
        </p>

        <a
          href="/api/movie/movie/<%= movie._id %>"
          class="inline-block mt-3 bg-blue-500 text-white px-4 py-2 rounded"
        >
            View Movie
        </a>

    </div>

</div>

<% }) %>

</div>

</body>
</html> 