<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MovieMania - Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a; /* slate-900 */
        }
        .movie-card:hover .movie-overlay {
            opacity: 1;
        }
        .movie-card:hover img {
            transform: scale(1.05);
        }
    </style>
</head>

<body class="text-white min-h-screen selection:bg-rose-500 selection:text-white">

<nav class="bg-slate-950/80 backdrop-blur-md sticky top-0 z-50 border-b border-white/10 px-8 py-4 flex justify-between items-center">
    <a href="/api/movie" class="text-3xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-rose-500 to-purple-600 tracking-tight">
        MovieMania
    </a>
    <div class="flex gap-4">
        <a href="/api/movie/movies" class="text-gray-300 hover:text-white font-medium transition-colors py-2 px-4">All Movies</a>
        <a href="/api/movie/add" class="bg-rose-600 hover:bg-rose-500 transition-colors shadow-[0_0_15px_rgba(225,29,72,0.5)] px-5 py-2 rounded-full text-white font-semibold flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Add Movie
        </a>
    </div>
</nav>

<main class="container mx-auto px-6 py-12">
    <div class="mb-12 flex justify-between items-end">
        <div>
            <h1 class="text-5xl font-extrabold mb-2 text-white">
                Latest Releases
            </h1>
            <p class="text-slate-400 text-lg">Discover the most trending movies right now.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-8">
        <% movies.forEach(movie => { %>
        <div class="movie-card group relative rounded-2xl overflow-hidden cursor-pointer shadow-2xl shadow-black/50 aspect-[2/3] bg-slate-800 transition-all duration-500 hover:shadow-[0_0_30px_rgba(225,29,72,0.3)]" onclick="window.location.href='/api/movie/movie/<%= movie._id %>'">
            
            <img src="<%= movie.imgUrl %>" alt="<%= movie.title %>" class="w-full h-full object-cover transition-transform duration-700 ease-out">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            
            <div class="absolute bottom-0 left-0 w-full p-5 flex flex-col justify-end translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                <h2 class="text-2xl font-bold text-white mb-1 leading-tight"><%= movie.title %></h2>
                <p class="text-rose-400 font-medium text-sm mb-3 truncate"><%= movie.hero %></p>
                
                <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
                    <a href="/api/movie/movie/<%= movie._id %>" class="bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white px-4 py-1.5 rounded-full text-sm font-semibold transition-colors flex-1 text-center">
                        Details
                    </a>
                </div>
            </div>

            <div class="movie-overlay absolute inset-0 bg-black/80 p-6 opacity-0 transition-opacity duration-300 flex flex-col justify-center items-center text-center">
                <p class="text-gray-300 text-sm line-clamp-6 mb-4">
                    <%= movie.description || 'No description available.' %>
                </p>
                <div class="mt-auto w-full flex gap-2">
                    <a href="/api/movie/movie/<%= movie._id %>" class="bg-rose-600 hover:bg-rose-500 w-full py-2 rounded-lg font-bold transition-colors">
                        View Full Details
                    </a>
                </div>
            </div>

        </div>
        <% }) %>
    </div>
</main>

</body>
</html>