<!DOCTYPE html>
<html>
  <head>
    <title>Edit Movie</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100">
    <div class="max-w-xl mx-auto mt-10 bg-white p-6 rounded shadow">
      <h1 class="text-3xl font-bold mb-6">Edit Movie</h1>

      <form action="/movie/update/<%= movie._id %>" method="POST">
        <input
          type="text"
          name="title"
          value="<%= movie.title %>"
          class="w-full border p-3 mb-4"
        />

        <input
          type="text"
          name="hero"
          value="<%= movie.hero %>"
          class="w-full border p-3 mb-4"
        />

        <input
          type="text"
          name="imgUrl"
          value="<%= movie.imgUrl %>"
          class="w-full border p-3 mb-4"
        />

        <textarea name="description" class="w-full border p-3 mb-4">
<%= movie.description %></textarea
        >

        <button class="bg-blue-500 text-white px-5 py-3 rounded">
          Update Movie
        </button>
      </form>
    </div>
  </body>
</html>
