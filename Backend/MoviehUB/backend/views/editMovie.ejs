<!DOCTYPE html>
<html>
  <head>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="max-w-xl mx-auto mt-10">
      <form action="/api/movie/update/<%= movie._id %>" method="POST">
        <input
          type="text"
          name="title"
          value="<%= movie.title %>"
          class="border p-2 w-full mb-3"
        />

        <input
          type="text"
          name="hero"
          value="<%= movie.hero %>"
          class="border p-2 w-full mb-3"
        />

        <textarea name="description" class="border p-2 w-full mb-3">
<%= movie.description %></textarea
        >

        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">
          Update Movie
        </button>
      </form>
    </div>
  </body>
</html>
