<!DOCTYPE html>
<html>
  <head>
    <title>Add Movie</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100">
    <div class="max-w-xl mx-auto mt-10 bg-white p-6 rounded shadow">
      <h1 class="text-3xl font-bold mb-6">Add Movie</h1>

      <form action="/movie/add" method="POST">
        <input
          type="text"
          name="title"
          placeholder="Movie Title"
          class="w-full border p-3 mb-4"
        />

        <input
          type="text"
          name="hero"
          placeholder="Hero"
          class="w-full border p-3 mb-4"
        />

        <input
          type="text"
          name="imgUrl"
          placeholder="Image URL"
          class="w-full border p-3 mb-4"
        />

        <textarea
          name="description"
          placeholder="Description"
          class="w-full border p-3 mb-4"
        ></textarea>

        <button class="bg-green-500 text-white px-5 py-3 rounded">
          Add Movie
        </button>
      </form>
    </div>
  </body>
</html>
