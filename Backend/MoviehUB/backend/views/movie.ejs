<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - MovieMania</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #0f172a; }
    </style>
</head>
<body class="text-white min-h-screen selection:bg-rose-500 selection:text-white">

<nav class="bg-slate-950/80 backdrop-blur-md sticky top-0 z-50 border-b border-white/10 px-8 py-4 flex justify-between items-center absolute w-full">
    <a href="/api/movie" class="text-3xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-rose-500 to-purple-600 tracking-tight">
        MovieMania
    </a>
    <div class="flex gap-4">
        <a href="/api/movie/movies" class="text-gray-300 hover:text-white font-medium transition-colors py-2 px-4">All Movies</a>
    </div>
</nav>

<!-- Hero Section with Background Blur -->
<div class="relative w-full h-[60vh] md:h-[70vh] flex items-center justify-center overflow-hidden">
    <!-- Blurred Background Image -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat blur-xl opacity-30 scale-110" style="background-image: url('<%= movie.imgUrl %>');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0f172a] via-[#0f172a]/60 to-transparent"></div>
    
    <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-end gap-8 pb-10 h-full mt-20">
        <!-- Movie Poster -->
        <img src="<%= movie.imgUrl %>" alt="<%= movie.title %>" class="w-48 md:w-64 rounded-2xl shadow-[0_0_40px_rgba(0,0,0,0.8)] border border-white/10 shrink-0 transform translate-y-12">
        
        <!-- Movie Titles and Quick Info -->
        <div class="pb-6 md:pb-12">
            <h1 class="text-5xl md:text-7xl font-extrabold mb-4 text-white drop-shadow-lg"><%= movie.title %></h1>
            <div class="flex flex-wrap items-center gap-4 text-slate-300 font-medium">
                <span class="bg-rose-600/20 text-rose-400 px-3 py-1 rounded-full border border-rose-500/30">Action / Drama</span>
                <span class="flex items-center gap-1">
                    <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                    4.8
                </span>
                <span><%= movie.duration %> Minutes</span>
            </div>
        </div>
    </div>
</div>

<main class="container mx-auto px-6 py-20 mt-12 grid grid-cols-1 lg:grid-cols-3 gap-12">
    <!-- Left Column: Details -->
    <div class="lg:col-span-1 space-y-8">
        <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl p-6 border border-white/5 shadow-xl">
            <h3 class="text-xl font-bold mb-4 text-white border-b border-white/10 pb-2">Cast & Crew</h3>
            <div class="space-y-4 text-slate-300">
                <div>
                    <span class="block text-sm text-slate-500 mb-1">Hero / Protagonist</span>
                    <span class="font-semibold text-white text-lg"><%= movie.hero %></span>
                </div>
                <div>
                    <span class="block text-sm text-slate-500 mb-1">Full Cast</span>
                    <span class="font-medium leading-relaxed"><%= movie.cast || 'Cast information not available.' %></span>
                </div>
            </div>
        </div>

        <div class="flex gap-4">
            <a href="/api/movie/movie/edit/<%= movie._id %>" class="flex-1 bg-blue-600/80 hover:bg-blue-500 transition-colors py-3 rounded-xl font-bold text-center border border-blue-500/50 shadow-[0_0_15px_rgba(37,99,235,0.3)]">
                Edit Details
            </a>
            <form action="/api/movie/delete/<%= movie._id %>" method="POST" class="flex-1" onsubmit="return confirm('Are you sure you want to permanently delete this movie?');">
                <button type="submit" class="w-full h-full bg-red-600/80 hover:bg-red-500 transition-colors py-3 rounded-xl font-bold text-center border border-red-500/50 shadow-[0_0_15px_rgba(220,38,38,0.3)]">
                    Delete Movie
                </button>
            </form>
        </div>
    </div>

    <!-- Right Column: Synopsis & Trailer -->
    <div class="lg:col-span-2 space-y-12">
        <section>
            <h2 class="text-3xl font-extrabold mb-4 text-white flex items-center gap-3">
                <span class="w-8 h-1 bg-rose-500 rounded-full"></span>
                Synopsis
            </h2>
            <p class="text-lg text-slate-300 leading-relaxed max-w-4xl">
                <%= movie.description %>
            </p>
        </section>

        <% if (movie.trailerMp4) { %>
        <section>
            <h2 class="text-3xl font-extrabold mb-6 text-white flex items-center gap-3">
                <span class="w-8 h-1 bg-rose-500 rounded-full"></span>
                Official Trailer
            </h2>
            <div class="w-full aspect-video rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-black">
                <iframe 
                    class="w-full h-full" 
                    src="<%= movie.trailerMp4.includes('watch?v=') ? movie.trailerMp4.replace('watch?v=', 'embed/') : movie.trailerMp4 %>" 
                    title="YouTube video player" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    allowfullscreen>
                </iframe>
            </div>
        </section>
        <% } else { %>
        <section>
            <div class="w-full aspect-video rounded-2xl border border-dashed border-white/20 flex flex-col items-center justify-center text-slate-500 bg-slate-900/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <p class="text-xl font-medium">No trailer available for this movie.</p>
                <p class="text-sm mt-2">Edit this movie to add a YouTube embed link.</p>
            </div>
        </section>
        <% } %>
    </div>
</main>

</body>
</html>